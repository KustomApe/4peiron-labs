# /etc/crontab と /etc/cron.d/* をまとめたもの
# m  h  dom mon dow user    command
17 *    * * *   root    cd / && run-parts --report /etc/cron.hourly
30 2    * * *   root    /opt/backup/run.sh >> /var/log/backup.log 2>&1
45 2    * * *   root    /usr/local/sbin/rotate-app-logs.sh
0  3    * * *   root    /opt/cleanup/clean.sh
10 6    * * 1   report  /opt/report/build.sh
*/5 *   * * *   app     /opt/app/bin/healthcheck
